<UserControl x:Class="Software_Project_P3_Death_Marble.Views.StageCustomPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#10080C"
             MinWidth="1000"
             MinHeight="700"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <!-- 픽셀 버튼 -->
        <Style x:Key="PixelButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFF0D5"/>
            <Setter Property="Background" Value="#A52A20"/>
            <Setter Property="BorderBrush" Value="#F4A64B"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D94327"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#651612"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F2C27D"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- 상단 -->
        <Border Grid.Row="0"
                Background="#210D12"
                BorderBrush="#A65335"
                BorderThickness="0,0,0,4">

            <Grid Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="STAGE CUSTOMIZER"
                           FontFamily="Consolas"
                           FontSize="32"
                           FontWeight="Black"
                           Foreground="#F28A3C"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="CREATE YOUR OWN HELL"
                           FontFamily="Consolas"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#F2C27D"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 메인 영역 -->
        <Grid Grid.Row="1" Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 맵 편집 -->
            <Border Grid.Column="0"
                    Background="#1A1014"
                    BorderBrush="#A65335"
                    BorderThickness="3"
                    Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="PIXEL MAP EDITOR"
                               Style="{StaticResource PanelTitle}"
                               Margin="0,0,0,15"/>

                    <!-- 맵 격자 -->
                    <Border Grid.Row="1"
                            Background="#10090C"
                            BorderBrush="#643225"
                            BorderThickness="2"
                            ClipToBounds="True">

                        <Canvas x:Name="MapViewport"
                                Background="#170E12"
                                ClipToBounds="True"
                                Cursor="Hand"
                                SizeChanged="MapViewport_SizeChanged"
                                MouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
                                MouseMove="MapViewport_MouseMove"
                                MouseLeftButtonUp="MapViewport_MouseLeftButtonUp"
                                MouseRightButtonDown="MapViewport_MouseRightButtonDown"
                                MouseWheel="MapViewport_MouseWheel">
                            <Canvas x:Name="MapCanvas"
                                    IsHitTestVisible="False"
                                    RenderTransformOrigin="0,0"/>
                        </Canvas>
                    </Border>

                    <TextBlock Grid.Row="2"
                               x:Name="EditorStatusText"
                               Text="빈 격자를 클릭해 타일 추가 · 타일 우클릭 두 번: 삭제 · 드래그: 이동 · 휠: 확대/축소"
                               FontSize="14"
                               Foreground="#E8C6A5"
                               Margin="0,15,0,0"/>
                </Grid>
            </Border>

            <!-- 오른쪽: 편집 도구 -->
            <Border Grid.Column="2"
                    Background="#170E12"
                    BorderBrush="#A65335"
                    BorderThickness="3"
                    Padding="18">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="STAGE SETTINGS"
                                   Style="{StaticResource PanelTitle}"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="스테이지 이름"
                                   Foreground="#FFE1BF"
                                   FontSize="16"
                                   Margin="0,0,0,8"/>

                        <TextBox x:Name="StageNameTextBox"
                                 Text="새로운 지옥"
                                 Height="42"
                                 FontSize="17"
                                 Foreground="#FFE1BF"
                                 Background="#241519"
                                 BorderBrush="#A65335"
                                 BorderThickness="2"
                                 Padding="10,6"/>

                        <TextBlock Text="TILE TYPE"
                                   Style="{StaticResource PanelTitle}"
                                   Margin="0,25,0,12"/>

                        <ComboBox x:Name="TileTypeCombo"
                                  Height="42"
                                  FontSize="16"
                                  SelectedIndex="0"
                                  Background="#241519"
                                  Foreground="#F2C27D"
                                  BorderBrush="#A65335"
                                  BorderThickness="2"
                                  SelectionChanged="TileTypeCombo_SelectionChanged">

                            <ComboBoxItem Content="일반 타일"/>
                            <ComboBoxItem Content="데미지 타일"/>
                            <ComboBoxItem Content="회복 타일"/>
                            <ComboBoxItem Content="카드 타일"/>
                            <ComboBoxItem Content="감옥 타일"/>
                            <ComboBoxItem Content="텔레포트 타일"/>
                            <ComboBoxItem Content="구멍 타일"/>

                        </ComboBox>

                        <TextBlock Text="선택한 타일의 유형을 바꿉니다. 빈 격자에 새 타일을 놓을 때는 기본 유형으로 사용됩니다."
                                   Foreground="#E8C6A5"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="선택 타일 값 (Amount)"
                                   Foreground="#FFE1BF"
                                   FontSize="16"
                                   Margin="0,16,0,8"/>

                        <TextBox x:Name="TileAmountTextBox"
                                 Text="1"
                                 Height="42"
                                 FontSize="17"
                                 Foreground="#FFE1BF"
                                 Background="#241519"
                                 BorderBrush="#A65335"
                                 BorderThickness="2"
                                 Padding="10,6"
                                 ToolTip="선택 타일의 Amount 값입니다. 새 타일 배치에도 사용됩니다."
                                 TextChanged="TileAmountTextBox_TextChanged"
                                 LostKeyboardFocus="TileAmountTextBox_LostKeyboardFocus"/>

                        <TextBlock Text="데미지·회복 타일에 적용되는 수치입니다."
                                   Foreground="#E8C6A5"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="EDIT TOOLS"
                                   Style="{StaticResource PanelTitle}"
                                   Margin="0,25,0,12"/>

                        <Button Content="■ 타일 배치"
                                Style="{StaticResource PixelButton}"
                                Click="PlaceTileButton_Click"/>

                        <Button Content="↗ 경로 연결"
                                Style="{StaticResource PixelButton}"
                                Background="#53315E"
                                BorderBrush="#C19BE5"
                                Click="ConnectTileButton_Click"/>

                        <Button Content="전체 초기화"
                                Style="{StaticResource PixelButton}"
                                Background="#241519"
                                BorderBrush="#825449"
                                Click="ClearMapButton_Click"/>

                        <Border Background="#29171A"
                                BorderBrush="#71372A"
                                BorderThickness="2"
                                Padding="12"
                                Margin="0,25,0,0">

                            <StackPanel>
                                <TextBlock Text="CARD EDITOR"
                                           Style="{StaticResource PanelTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,12"/>

                                <ListBox x:Name="CardsListBox"
                                         Height="100"
                                         DisplayMemberPath="Card.Name"
                                         Background="#241519"
                                         Foreground="#FFE1BF"
                                         BorderBrush="#A65335"
                                         BorderThickness="2"
                                         SelectionChanged="CardsListBox_SelectionChanged"/>

                                <Grid Margin="0,8,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="+ 카드 추가"
                                            Style="{StaticResource PixelButton}"
                                            Click="AddCardButton_Click"/>
                                    <Button x:Name="DeleteCardButton"
                                            Grid.Column="2"
                                            Content="카드 삭제"
                                            Style="{StaticResource PixelButton}"
                                            Background="#5B2222"
                                            BorderBrush="#D76E5E"
                                            Click="DeleteCardButton_Click"/>
                                </Grid>

                                <TextBlock Text="카드 개수 (CardEntry.Count)"
                                           Foreground="#FFE1BF"
                                           FontSize="14"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="CardCountTextBox"
                                         Height="36"
                                         FontSize="15"
                                         Foreground="#FFE1BF"
                                         Background="#241519"
                                         BorderBrush="#A65335"
                                         BorderThickness="2"
                                         Padding="8,5"
                                         Text="1"
                                         TextChanged="CardCountTextBox_TextChanged"
                                         LostKeyboardFocus="CardCountTextBox_LostKeyboardFocus"/>

                                <CheckBox x:Name="CardUsableCheckBox"
                                          Content="액티브 카드 (직접 사용 가능)"
                                          Foreground="#FFE1BF"
                                          FontSize="14"
                                          Margin="0,10,0,0"
                                          ToolTip="체크 해제하면 획득 즉시 발동하는 카드입니다."
                                          Checked="CardUsableCheckBox_Changed"
                                          Unchecked="CardUsableCheckBox_Changed"/>
                                <TextBlock Text="체크 해제: 즉발 카드"
                                           Foreground="#E8C6A5"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>

                                <TextBlock Text="카드 이름"
                                           Foreground="#FFE1BF"
                                           FontSize="14"
                                           Margin="0,10,0,5"/>
                                <TextBox x:Name="CardNameTextBox"
                                         Height="36"
                                         FontSize="15"
                                         Foreground="#FFE1BF"
                                         Background="#241519"
                                         BorderBrush="#A65335"
                                         BorderThickness="2"
                                         Padding="8,5"
                                         TextChanged="CardNameTextBox_TextChanged"/>

                                <TextBlock Text="카드 설명"
                                           Foreground="#FFE1BF"
                                           FontSize="14"
                                           Margin="0,10,0,5"/>
                                <TextBox x:Name="CardDescriptionTextBox"
                                         Height="76"
                                         FontSize="14"
                                         Foreground="#FFE1BF"
                                         Background="#241519"
                                         BorderBrush="#A65335"
                                         BorderThickness="2"
                                         Padding="8,5"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="CardDescriptionTextBox_TextChanged"/>

                                <TextBlock Text="카드 효과"
                                           Foreground="#FFE1BF"
                                           FontSize="14"
                                           Margin="0,12,0,5"/>
                                <ListBox x:Name="CardEffectsListBox"
                                         Height="120"
                                         Background="#241519"
                                         Foreground="#FFE1BF"
                                         BorderBrush="#A65335"
                                         BorderThickness="2"
                                         SelectionChanged="CardEffectsListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Type}"
                                                           Foreground="#F2C27D"
                                                           FontWeight="Bold"/>
                                                <TextBlock Foreground="#E8C6A5"
                                                           TextWrapping="Wrap">
                                                    <Run Text="대상: "/>
                                                    <Run Text="{Binding Target}"/>
                                                    <Run Text=" · 횟수: "/>
                                                    <Run Text="{Binding Count}"/>
                                                    <Run Text=" · 양: "/>
                                                    <Run Text="{Binding Amount}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Margin="0,8,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AddEffectButton"
                                            Grid.Column="0"
                                            Content="+ 효과 추가"
                                            Style="{StaticResource PixelButton}"
                                            Click="AddEffectButton_Click"/>
                                    <Button x:Name="DeleteEffectButton"
                                            Grid.Column="2"
                                            Content="효과 삭제"
                                            Style="{StaticResource PixelButton}"
                                            Background="#5B2222"
                                            BorderBrush="#D76E5E"
                                            Click="DeleteEffectButton_Click"/>
                                </Grid>

                                <TextBlock Text="효과 유형"
                                           Foreground="#FFE1BF"
                                           FontSize="14"
                                           Margin="0,4,0,5"/>
                                <ComboBox x:Name="EffectTypeCombo"
                                          Height="36"
                                          FontSize="14"
                                          Background="#241519"
                                          Foreground="#F2C27D"
                                          BorderBrush="#A65335"
                                          BorderThickness="2"
                                          SelectionChanged="EffectTypeCombo_SelectionChanged">
                                    <ComboBoxItem Content="효과 없음" Tag="None"/>
                                    <ComboBoxItem Content="피해" Tag="Damage"/>
                                    <ComboBoxItem Content="회복" Tag="Heal"/>
                                    <ComboBoxItem Content="텔레포트" Tag="Teleport"/>
                                    <ComboBoxItem Content="스왑" Tag="Swap"/>
                                </ComboBox>

                                <TextBlock Text="대상"
                                           Foreground="#FFE1BF"
                                           FontSize="14"
                                           Margin="0,8,0,5"/>
                                <ComboBox x:Name="EffectTargetCombo"
                                          Height="36"
                                          FontSize="14"
                                          Background="#241519"
                                          Foreground="#F2C27D"
                                          BorderBrush="#A65335"
                                          BorderThickness="2"
                                          SelectionChanged="EffectTargetCombo_SelectionChanged">
                                    <ComboBoxItem Content="자신" Tag="Self"/>
                                    <ComboBoxItem Content="다른 플레이어" Tag="Other"/>
                                    <ComboBoxItem Content="전체" Tag="All"/>
                                    <ComboBoxItem Content="무작위" Tag="Random"/>
                                </ComboBox>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="발동 횟수 (Count)"
                                                   Foreground="#FFE1BF"
                                                   FontSize="13"
                                                   Margin="0,0,0,5"/>
                                        <TextBox x:Name="EffectCountTextBox"
                                                 Height="36"
                                                 FontSize="14"
                                                 Foreground="#FFE1BF"
                                                 Background="#241519"
                                                 BorderBrush="#A65335"
                                                 BorderThickness="2"
                                                 Padding="8,5"
                                                 TextChanged="EffectValueTextBox_TextChanged"
                                                 LostKeyboardFocus="EffectValueTextBox_LostKeyboardFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="효과 양 (Amount)"
                                                   Foreground="#FFE1BF"
                                                   FontSize="13"
                                                   Margin="0,0,0,5"/>
                                        <TextBox x:Name="EffectAmountTextBox"
                                                 Height="36"
                                                 FontSize="14"
                                                 Foreground="#FFE1BF"
                                                 Background="#241519"
                                                 BorderBrush="#A65335"
                                                 BorderThickness="2"
                                                 Padding="8,5"
                                                 TextChanged="EffectValueTextBox_TextChanged"
                                                 LostKeyboardFocus="EffectValueTextBox_LostKeyboardFocus"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="텔레포트와 스왑 효과는 Amount를 사용하지 않습니다."
                                           Foreground="#E8C6A5"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#2C1719"
                                BorderBrush="#6D3026"
                                BorderThickness="2"
                                Padding="12"
                                Margin="0,25,0,0">

                            <StackPanel>

                                <TextBlock Text="EDITOR GUIDE"
                                           FontFamily="Consolas"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#F2A34A"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="1. 타일을 배치합니다."
                                           Foreground="#E8C6A5"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="2. 상하좌우로 인접한 타일만 연결할 수 있습니다. 이미 연결된 타일에도 갈림길을 추가할 수 있습니다."
                                           Foreground="#E8C6A5"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="첫 번째 타일이 시작 타일이 됩니다."
                                           Foreground="#E8C6A5"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="시작 경로와 연결할 때는 기존 진행 방향을 유지합니다. 그 외에는 클릭 순서로 방향을 정합니다."
                                           Foreground="#E8C6A5"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="4. 스테이지를 저장합니다."
                                           Foreground="#E8C6A5"/>

                                <TextBlock Text="타일을 우클릭 두 번하면 삭제됩니다."
                                           Foreground="#E8C6A5"
                                           Margin="0,8,0,0"/>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 하단 -->
        <Border Grid.Row="2"
                Background="#210D12"
                BorderBrush="#A65335"
                BorderThickness="0,3,0,0">

            <Grid Margin="25,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="◀ 뒤로 가기"
                        Style="{StaticResource PixelButton}"
                        Background="#21171A"
                        BorderBrush="#825449"
                        Click="BackButton_Click"/>

                <Button Grid.Column="2"
                        Content="스테이지 저장"
                        Style="{StaticResource PixelButton}"
                        Click="SaveStageButton_Click"/>

            </Grid>
        </Border>

    </Grid>
</UserControl>
