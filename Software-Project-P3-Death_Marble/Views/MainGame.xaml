<UserControl x:Class="Software_Project_P3_Death_Marble.Views.MainGame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#10080C">

    <UserControl.Resources>

        <Style x:Key="GameButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFF0D5"/>
            <Setter Property="Background" Value="#A52A20"/>
            <Setter Property="BorderBrush" Value="#F4A64B"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5"/>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="125"/>
        </Grid.RowDefinitions>

        <!-- 상단 -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="DEATH MARBLE"
                       FontFamily="Consolas"
                       FontSize="36"
                       FontWeight="Black"
                       Foreground="#F28A3C"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">

                <TextBlock x:Name="RoundText"
                           Text="ROUND 01 / 40"
                           FontFamily="Consolas"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#F2C27D"
                           HorizontalAlignment="Right"/>

                <TextBlock x:Name="SuddenDeathText"
                           Text="NORMAL MODE"
                           FontFamily="Consolas"
                           FontSize="14"
                           Foreground="#E8C6A5"
                           HorizontalAlignment="Right"/>

            </StackPanel>
        </Grid>

        <!-- 중앙 -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- 게임판 -->
            <Border Grid.Column="0"
                    Background="#1B1014"
                    BorderBrush="#A65335"
                    BorderThickness="4"
                    Padding="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="INFERNAL BOARD"
                               FontFamily="Consolas"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#F2C27D"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,10"/>

                    <Canvas x:Name="BoardViewport"
                            Grid.Row="1"
                            Background="#201217"
                            ClipToBounds="True"
                            Cursor="Hand"
                            SizeChanged="BoardViewport_SizeChanged"
                            MouseLeftButtonDown="BoardViewport_MouseLeftButtonDown"
                            MouseMove="BoardViewport_MouseMove"
                            MouseLeftButtonUp="BoardViewport_MouseLeftButtonUp"
                            MouseWheel="BoardViewport_MouseWheel">
                        <Canvas x:Name="BoardCanvas"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0,0"/>
                    </Canvas>

                    <Border x:Name="PathChoiceOverlay"
                            Grid.Row="1"
                            Panel.ZIndex="10"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Padding="18"
                            Background="#F01B1014"
                            BorderBrush="#F4A64B"
                            BorderThickness="3">
                        <StackPanel>
                            <TextBlock Text="SELECT NEXT TILE"
                                       FontFamily="Consolas"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#F2C27D"
                                       Margin="0,0,0,10"/>
                            <WrapPanel x:Name="PathChoiceButtons"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- 오른쪽 패널 -->
            <Border Grid.Column="2"
                    Background="#1B1014"
                    BorderBrush="#A65335"
                    BorderThickness="4"
                    Padding="15">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="PLAYER STATUS"
                                   FontFamily="Consolas"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#F2C27D"
                                   Margin="0,0,0,15"/>

                        <StackPanel x:Name="PlayerStatusPanel"/>

                        <Separator Background="#A65335"
                                   Margin="0,18"/>

                        <TextBlock Text="CURRENT TURN"
                                   FontFamily="Consolas"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F2C27D"/>

                        <TextBlock x:Name="CurrentTurnText"
                                   Text="PLAYER 1"
                                   FontFamily="Consolas"
                                   FontSize="27"
                                   FontWeight="Black"
                                   Foreground="White"
                                   Margin="0,8,0,18"/>

                        <Border Background="#29171A"
                                BorderBrush="#A65335"
                                BorderThickness="3"
                                Padding="15">

                            <StackPanel>

                                <TextBlock Text="DICE"
                                           FontFamily="Consolas"
                                           FontSize="17"
                                           Foreground="#F2C27D"
                                           HorizontalAlignment="Center"/>

                                <TextBlock x:Name="DiceText"
                                           Text="?"
                                           FontFamily="Consolas"
                                           FontSize="54"
                                           FontWeight="Black"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>
                        </Border>

                        <Button x:Name="RollDiceButton"
                                Content="▶ 주사위 굴리기"
                                Style="{StaticResource GameButton}"
                                Margin="0,18,0,0"
                                Click="RollDiceButton_Click"/>

                        <Button x:Name="CardButton"
                                Content="카드 사용"
                                Style="{StaticResource GameButton}"
                                Background="#53315E"
                                BorderBrush="#C19BE5"
                                IsEnabled="False"/>

                        <Button Content="게임 종료"
                                Style="{StaticResource GameButton}"
                                Background="#25171B"
                                BorderBrush="#825449"
                                Margin="0,20,0,0"
                                Click="ExitButton_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 게임 로그 -->
        <Border Grid.Row="2"
                Background="#170E12"
                BorderBrush="#A65335"
                BorderThickness="3"
                Margin="0,15,0,0"
                Padding="12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="GAME LOG"
                           FontFamily="Consolas"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#F2C27D"/>

                <ScrollViewer x:Name="LogScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,8,0,0">

                    <StackPanel x:Name="GameLogPanel"/>

                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</UserControl>
