                           Canvas.Top="755"/>

                <!-- 용암 픽셀 무늬 -->
                <Rectangle Width="100" Height="20"
                           Fill="#F16A27"
                           Canvas.Left="50" Canvas.Top="730"/>

                <Rectangle Width="150" Height="15"
                           Fill="#F16A27"
                           Canvas.Left="250" Canvas.Top="770"/>

                <Rectangle Width="120" Height="20"
                           Fill="#F16A27"
                           Canvas.Left="650" Canvas.Top="725"/>

                <Rectangle Width="180" Height="15"
                           Fill="#F16A27"
                           Canvas.Left="950" Canvas.Top="765"/>

                <!-- 왼쪽 픽셀 불꽃 -->
                <Rectangle Width="40" Height="80"
                           Fill="#9C2D16"
                           Canvas.Left="90" Canvas.Top="650"/>

                <Rectangle Width="40" Height="110"
                           Fill="#C6441B"
                           Canvas.Left="130" Canvas.Top="620"/>

                <Rectangle Width="30" Height="60"
                           Fill="#E86725"
                           Canvas.Left="140" Canvas.Top="660"/>

                <Rectangle Width="25" Height="45"
                           Fill="#E86725"
                           Canvas.Left="155" Canvas.Top="590"/>

                <!-- 오른쪽 픽셀 불꽃 -->
                <Rectangle Width="40" Height="90"
                           Fill="#9C2D16"
                           Canvas.Left="1010" Canvas.Top="640"/>

                <Rectangle Width="40" Height="120"
                           Fill="#C6441B"
                           Canvas.Left="1050" Canvas.Top="610"/>

                <Rectangle Width="30" Height="65"
                           Fill="#E86725"
                           Canvas.Left="1060" Canvas.Top="655"/>

                <Rectangle Width="25" Height="45"
                           Fill="#E86725"
                           Canvas.Left="1075" Canvas.Top="580"/>

                <!-- 작은 불씨 -->
                <Rectangle Width="12" Height="12"
                           Fill="#F4A64B"
                           Canvas.Left="200" Canvas.Top="580"/>

                <Rectangle Width="10" Height="10"
                           Fill="#F4A64B"
                           Canvas.Left="970" Canvas.Top="520"/>

                <Rectangle Width="8" Height="8"
                           Fill="#E86725"
                           Canvas.Left="780" Canvas.Top="640"/>

            </Canvas>
        </Viewbox>

        <!-- 어두운 오버레이 -->
        <Rectangle Fill="#44000000"
                   IsHitTestVisible="False"/>

        <!-- 중앙 콘텐츠 -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,-15,0,0">

            <!-- 상단 문구 -->
            <TextBlock Text="✦  ENTER THE ABYSS  ✦"
                       FontFamily="Consolas"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#E8A76B"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <!-- 게임 로고 -->
            <TextBlock Text="DEATH"
                       FontFamily="Consolas"
                       FontSize="105"
                       FontWeight="Black"
                       Foreground="#F28A3C"
                       HorizontalAlignment="Center">

                <TextBlock.Effect>
                    <DropShadowEffect Color="#D93819"
                                      BlurRadius="12"
                                      ShadowDepth="5"
                                      Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="M A R B L E"
                       FontFamily="Consolas"
                       FontSize="50"
                       FontWeight="Bold"
                       Foreground="#F2C27D"
                       HorizontalAlignment="Center"
                       Margin="0,-15,0,0"/>

            <!-- 픽셀 구분선 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,25,0,20">

                <Rectangle Width="90" Height="5"
                           Fill="#A83B24"/>

                <Rectangle Width="30" Height="5"
                           Fill="#F2A34A"/>

                <Rectangle Width="90" Height="5"
                           Fill="#A83B24"/>
            </StackPanel>

            <!-- 게임 설명 -->
            <TextBlock Text="운명의 주사위를 굴려라"
                       FontSize="21"
                       FontWeight="Bold"
                       Foreground="#FFE1BF"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="마지막까지 살아남는 자만이 승리한다"
                       FontSize="15"
                       Foreground="#C9A89B"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,35"/>

            <!-- 게임 시작 -->
            <Button Content="▶  지옥의 게임 시작"
                    Style="{StaticResource PixelButton}"
                    HorizontalAlignment="Center"
                    Click="StartButton_Click"/>

            <!-- 게임 종료 -->
            <Button Content="게임 종료"
                    Style="{StaticResource PixelDarkButton}"
                    HorizontalAlignment="Center"
                    Click="ExitButton_Click"/>

            <!-- 하단 정보 -->
            <TextBlock Text="2 - 4 PLAYERS  |  STRATEGY  |  SURVIVAL"
                       FontFamily="Consolas"
                       FontSize="13"
                       Foreground="#B58A79"
                       HorizontalAlignment="Center"
                       Margin="0,30,0,0"/>

        </StackPanel>

        <!-- 버전 표시 -->
        <TextBlock Text="DEATH MARBLE  |  PIXEL EDITION"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="#AA866D"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,25,18"/>

    </Grid>
</UserControl>