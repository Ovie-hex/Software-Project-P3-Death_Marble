<UserControl x:Class="Software_Project_P3_Death_Marble.Views.InitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="700"
             MinHeight="550"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <!-- 픽셀 게임 버튼 -->
        <Style x:Key="PixelButton" TargetType="Button">
            <Setter Property="Width" Value="310"/>
            <Setter Property="Height" Value="65"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFF0D5"/>
            <Setter Property="Background" Value="#A52A20"/>
            <Setter Property="BorderBrush" Value="#F4A64B"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 픽셀 그림자 -->
                            <Border Background="#090608"
                                    Margin="6,6,0,0"/>

                            <!-- 버튼 본체 -->
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">

                                <Grid>
                                    <Border Margin="5"
                                            BorderBrush="#66FFBD74"
                                            BorderThickness="1"/>

                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D94327"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#651612"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 종료 버튼 -->
        <Style x:Key="PixelDarkButton"
               TargetType="Button"
               BasedOn="{StaticResource PixelButton}">
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#21171A"/>
            <Setter Property="BorderBrush" Value="#825449"/>
        </Style>

    </UserControl.Resources>

    <!-- 전체 화면 -->
    <Grid Background="#10080C"
          ClipToBounds="True">

        <!-- 픽셀 배경: 1200x800 기준 -->
        <Viewbox Stretch="UniformToFill"
                 IsHitTestVisible="False">

            <Canvas Width="1200"
                    Height="800"
                    Background="#10080C">

                <!-- 배경의 붉은 하늘 -->
