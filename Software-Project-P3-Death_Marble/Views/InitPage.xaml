                <Rectangle Width="10" Height="10"
                           Fill="#E46B38"
                           Canvas.Left="900" Canvas.Top="200"/>

                <!-- 붉은 달의 픽셀 후광 -->
                <Rectangle Width="280" Height="200"
                           Fill="#44201B"
                           Canvas.Left="460" Canvas.Top="70"/>

                <Rectangle Width="320" Height="160"
                           Fill="#44201B"
                           Canvas.Left="440" Canvas.Top="90"/>

                <Rectangle Width="240" Height="240"
                           Fill="#44201B"
                           Canvas.Left="480" Canvas.Top="50"/>

                <!-- 픽셀 달 -->
                <Rectangle Width="180" Height="240"
                           Fill="#A92E1E"
                           Canvas.Left="510" Canvas.Top="70"/>

                <Rectangle Width="240" Height="180"
                           Fill="#A92E1E"
                           Canvas.Left="480" Canvas.Top="100"/>

                <Rectangle Width="220" Height="200"
                           Fill="#C94726"
                           Canvas.Left="490" Canvas.Top="90"/>

                <Rectangle Width="160" Height="160"
                           Fill="#D9582C"
                           Canvas.Left="520" Canvas.Top="110"/>

                <!-- 달의 픽셀 무늬 -->
                <Rectangle Width="40" Height="40"
