<UserControl x:Class="Software_Project_P3_Death_Marble.Views.StageCustomPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#10080C"
             MinWidth="1000"
             MinHeight="700"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <!-- 픽셀 버튼 -->
        <Style x:Key="PixelButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFF0D5"/>
            <Setter Property="Background" Value="#A52A20"/>
            <Setter Property="BorderBrush" Value="#F4A64B"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D94327"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#651612"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F2C27D"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- 상단 -->
        <Border Grid.Row="0"
                Background="#210D12"
                BorderBrush="#A65335"
                BorderThickness="0,0,0,4">

            <Grid Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="STAGE CUSTOMIZER"
                           FontFamily="Consolas"
                           FontSize="32"
                           FontWeight="Black"
                           Foreground="#F28A3C"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="CREATE YOUR OWN HELL"
                           FontFamily="Consolas"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#F2C27D"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 메인 영역 -->
        <Grid Grid.Row="1" Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 맵 편집 -->
            <Border Grid.Column="0"
                    Background="#1A1014"
                    BorderBrush="#A65335"
                    BorderThickness="3"
                    Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="PIXEL MAP EDITOR"
                               Style="{StaticResource PanelTitle}"
                               Margin="0,0,0,15"/>

                    <!-- 맵 격자 -->
                    <Border Grid.Row="1"
                            Background="#10090C"
                            BorderBrush="#643225"
                            BorderThickness="2"
                            ClipToBounds="True">

                        <Viewbox Stretch="Uniform">

                            <Canvas x:Name="MapCanvas"
                                    Width="700"
                                    Height="500"
                                    Background="#170E12"
                                    MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown">

                                <!-- 타일 및 경로가 동적으로 생성됨 -->

                            </Canvas>
                        </Viewbox>
                    </Border>

                    <TextBlock Grid.Row="2"
                               x:Name="EditorStatusText"
                               Text="격자를 클릭하여 타일을 배치하세요."
                               FontSize="14"
                               Foreground="#E8C6A5"
                               Margin="0,15,0,0"/>
                </Grid>
            </Border>

            <!-- 오른쪽: 편집 도구 -->
            <Border Grid.Column="2"
                    Background="#170E12"
                    BorderBrush="#A65335"
                    BorderThickness="3"
                    Padding="18">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="STAGE SETTINGS"
                                   Style="{StaticResource PanelTitle}"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="스테이지 이름"
                                   Foreground="#FFE1BF"
                                   FontSize="16"
                                   Margin="0,0,0,8"/>

                        <TextBox x:Name="StageNameTextBox"
                                 Text="새로운 지옥"
                                 Height="42"
                                 FontSize="17"
                                 Foreground="#FFE1BF"
                                 Background="#241519"
                                 BorderBrush="#A65335"
                                 BorderThickness="2"
                                 Padding="10,6"/>

                        <TextBlock Text="TILE TYPE"
                                   Style="{StaticResource PanelTitle}"
                                   Margin="0,25,0,12"/>

                        <ComboBox x:Name="TileTypeCombo"
                                  Height="42"
                                  FontSize="16"
                                  SelectedIndex="0"
                                  Background="#241519"
                                  Foreground="#F2C27D"
                                  BorderBrush="#A65335"
                                  BorderThickness="2">

                            <ComboBoxItem Content="일반 타일"/>
                            <ComboBoxItem Content="데미지 타일"/>
                            <ComboBoxItem Content="회복 타일"/>
                            <ComboBoxItem Content="카드 타일"/>
                            <ComboBoxItem Content="감옥 타일"/>
                            <ComboBoxItem Content="텔레포트 타일"/>
                            <ComboBoxItem Content="함정 타일"/>

                        </ComboBox>

                        <TextBlock Text="EDIT TOOLS"
                                   Style="{StaticResource PanelTitle}"
                                   Margin="0,25,0,12"/>

                        <Button Content="■ 타일 배치"
                                Style="{StaticResource PixelButton}"
                                Click="PlaceTileButton_Click"/>

                        <Button Content="↗ 경로 연결"
                                Style="{StaticResource PixelButton}"
                                Background="#53315E"
                                BorderBrush="#C19BE5"
                                Click="ConnectTileButton_Click"/>

                        <Button Content="★ 시작 타일 지정"
                                Style="{StaticResource PixelButton}"
                                Background="#2B6248"
                                BorderBrush="#7ED7A0"
                                Click="SetStartTileButton_Click"/>

                        <Button Content="X 타일 삭제"
                                Style="{StaticResource PixelButton}"
                                Background="#5B2222"
                                Click="DeleteTileButton_Click"/>

                        <Button Content="전체 초기화"
                                Style="{StaticResource PixelButton}"
                                Background="#241519"
                                BorderBrush="#825449"
                                Click="ClearMapButton_Click"/>

                        <Border Background="#2C1719"
                                BorderBrush="#6D3026"
                                BorderThickness="2"
                                Padding="12"
                                Margin="0,25,0,0">

                            <StackPanel>

                                <TextBlock Text="EDITOR GUIDE"
                                           FontFamily="Consolas"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#F2A34A"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="1. 타일을 배치합니다."
                                           Foreground="#E8C6A5"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="2. 경로를 연결합니다."
                                           Foreground="#E8C6A5"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="3. 시작 타일을 지정합니다."
                                           Foreground="#E8C6A5"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="4. 스테이지를 저장합니다."
                                           Foreground="#E8C6A5"/>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 하단 -->
        <Border Grid.Row="2"
                Background="#210D12"
                BorderBrush="#A65335"
                BorderThickness="0,3,0,0">

            <Grid Margin="25,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="◀ 뒤로 가기"
                        Style="{StaticResource PixelButton}"
                        Background="#21171A"
                        BorderBrush="#825449"
                        Click="BackButton_Click"/>

                <Button Grid.Column="2"
                        Content="스테이지 저장"
                        Style="{StaticResource PixelButton}"
                        Click="SaveStageButton_Click"/>

            </Grid>
        </Border>

    </Grid>
</UserControl>
