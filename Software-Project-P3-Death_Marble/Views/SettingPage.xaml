<UserControl x:Class="Software_Project_P3_Death_Marble.Views.SettingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#10080C"
             MinWidth="850"
             MinHeight="650">

    <UserControl.Resources>

        <Style x:Key="PixelButton" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFF0D5"/>
            <Setter Property="Background" Value="#A52A20"/>
            <Setter Property="BorderBrush" Value="#F4A64B"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,7"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="#090608"
                                    Margin="5,5,0,0"/>

                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D94327"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F2C27D"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,35">

            <TextBlock Text="GAME SETTINGS"
                       FontFamily="Consolas"
                       FontSize="46"
                       FontWeight="Black"
                       Foreground="#F28A3C"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="PREPARE FOR THE INFERNAL GAME"
                       FontFamily="Consolas"
                       FontSize="15"
                       Foreground="#F2C27D"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>

        </StackPanel>

        <!-- 설정 패널 -->
        <Border Grid.Row="1"
                Width="650"
                MaxHeight="550"
                Background="#1C1014"
                BorderBrush="#A65335"
                BorderThickness="4"
                Padding="30"
                HorizontalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- 플레이어 수 -->
                    <TextBlock Text="PLAYER COUNT"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="참가할 플레이어 수를 선택하세요."
                               Foreground="#E8C6A5"
                               FontSize="15"
                               Margin="0,0,0,15"/>

                    <ComboBox x:Name="PlayerCountCombo"
                              Height="45"
                              FontSize="18"
                              SelectedIndex="0"
                              Background="#241519"
                              Foreground="#F2C27D"
                              BorderBrush="#A65335"
                              BorderThickness="2"
                              SelectionChanged="PlayerCountCombo_SelectionChanged">

                        <ComboBoxItem Content="2 PLAYERS"/>
                        <ComboBoxItem Content="3 PLAYERS"/>
                        <ComboBoxItem Content="4 PLAYERS"/>

                    </ComboBox>

                    <!-- 참가 플레이어 -->
                    <Border Background="#29171A"
                            BorderBrush="#71372A"
                            BorderThickness="2"
                            Padding="15"
                            Margin="0,20,0,0">

                        <StackPanel>

                            <TextBlock Text="PARTICIPANTS"
                                       Style="{StaticResource SectionTitle}"
                                       FontSize="17"
                                       Margin="0,0,0,12"/>

                            <StackPanel x:Name="PlayerPreviewPanel"/>

                        </StackPanel>
                    </Border>

                    <!-- 스테이지 -->
                    <TextBlock Text="SELECT STAGE"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,28,0,12"/>

                    <ListBox x:Name="StageListBox"
                             Height="125"
                             Background="#241519"
                             Foreground="#FFE1BF"
                             BorderBrush="#A65335"
                             BorderThickness="2"
                             FontSize="16"
                             Padding="8"
                             DisplayMemberPath="Name"
                             MouseDoubleClick="StageListBox_MouseDoubleClick"/>

                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="+ 스테이지 추가"
                                Style="{StaticResource PixelButton}"
                                Background="#53315E"
                                BorderBrush="#C19BE5"
                                Margin="0,7,0,7"
                                Click="CreateStageButton_Click"/>

                        <Button Grid.Column="2"
                                Content="× 스테이지 삭제"
                                Style="{StaticResource PixelButton}"
                                Background="#5B2222"
                                BorderBrush="#D76E5E"
                                Margin="0,7,0,7"
                                Click="DeleteStageButton_Click"/>
                    </Grid>

                    <!-- 턴 결정 안내 -->
                    <Border Background="#29171A"
                            BorderBrush="#71372A"
                            BorderThickness="2"
                            Padding="15"
                            Margin="0,22,0,0">

                        <StackPanel>

                            <TextBlock Text="TURN ORDER"
                                       Style="{StaticResource SectionTitle}"
                                       FontSize="17"/>

                            <TextBlock Text="게임 시작 시 룰렛으로 턴 순서를 결정합니다."
                                       Foreground="#E8C6A5"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>

                            <TextBlock Text="모든 플레이어는 직접 조작합니다."
                                       Foreground="#E8C6A5"
                                       FontSize="14"
                                       Margin="0,6,0,0"/>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 하단 버튼 -->
        <Grid Grid.Row="2"
              Width="650"
              HorizontalAlignment="Center"
              Margin="0,25,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="◀ 뒤로 가기"
                    Style="{StaticResource PixelButton}"
                    Background="#21171A"
                    BorderBrush="#825449"
                    Click="BackButton_Click"/>

            <Button Grid.Column="2"
                    Content="▶ 게임 시작"
                    Style="{StaticResource PixelButton}"
                    Click="StartGameButton_Click"/>

        </Grid>

    </Grid>
</UserControl>
