<UserControl x:Class="Software_Project_P3_Death_Marble.Views.ResultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#10080C"
             MinWidth="850"
             MinHeight="650"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <!-- 픽셀 버튼 -->
        <Style x:Key="PixelButton" TargetType="Button">
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFF0D5"/>
            <Setter Property="Background" Value="#A52A20"/>
            <Setter Property="BorderBrush" Value="#F4A64B"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Grid>
                            <!-- 픽셀 그림자 -->
                            <Border Background="#090608"
                                    Margin="5,5,0,0"/>

                            <!-- 버튼 본체 -->
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D94327"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#651612"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 패널 제목 -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F2C27D"/>
        </Style>

    </UserControl.Resources>

    <Grid ClipToBounds="True">

        <!-- 배경 픽셀아트 -->
        <Viewbox Stretch="UniformToFill"
                 IsHitTestVisible="False">

            <Canvas Width="1200"
                    Height="800"
                    Background="#17090D">

                <!-- 지옥의 하늘 -->
                <Rectangle Width="1200"
                           Height="300"
                           Fill="#270D11"
                           Canvas.Top="500"/>

                <!-- 붉은 달 -->
                <Rectangle Width="180"
                           Height="220"
                           Fill="#80261C"
                           Canvas.Left="510"
                           Canvas.Top="45"/>

                <Rectangle Width="240"
                           Height="160"
                           Fill="#80261C"
                           Canvas.Left="480"
                           Canvas.Top="75"/>

                <Rectangle Width="160"
                           Height="180"
                           Fill="#B83C23"
                           Canvas.Left="520"
                           Canvas.Top="65"/>

                <!-- 성벽 -->
                <Rectangle Width="170"
                           Height="650"
                           Fill="#10090C"
                           Canvas.Left="0"
                           Canvas.Top="230"/>

                <Rectangle Width="170"
                           Height="650"
                           Fill="#10090C"
                           Canvas.Left="1030"
                           Canvas.Top="230"/>

                <!-- 픽셀 성벽 톱니 -->
                <Rectangle Width="80"
                           Height="50"
                           Fill="#10090C"
                           Canvas.Left="0"
                           Canvas.Top="190"/>

                <Rectangle Width="80"
                           Height="50"
                           Fill="#10090C"
                           Canvas.Left="120"
                           Canvas.Top="190"/>

                <Rectangle Width="80"
                           Height="50"
                           Fill="#10090C"
                           Canvas.Left="1000"
                           Canvas.Top="190"/>

                <Rectangle Width="80"
                           Height="50"
                           Fill="#10090C"
                           Canvas.Left="1120"
                           Canvas.Top="190"/>

                <!-- 용암 -->
                <Rectangle Width="1200"
                           Height="110"
                           Fill="#8F2715"
                           Canvas.Top="690"/>

                <Rectangle Width="1200"
                           Height="40"
                           Fill="#C63D18"
                           Canvas.Top="760"/>

                <!-- 용암 픽셀 -->
                <Rectangle Width="120"
                           Height="15"
                           Fill="#F16A27"
                           Canvas.Left="80"
                           Canvas.Top="740"/>

                <Rectangle Width="150"
                           Height="15"
                           Fill="#F16A27"
                           Canvas.Left="900"
                           Canvas.Top="770"/>

                <!-- 픽셀 불꽃 -->
                <Rectangle Width="40"
                           Height="100"
                           Fill="#C6441B"
                           Canvas.Left="220"
                           Canvas.Top="630"/>

                <Rectangle Width="25"
                           Height="50"
                           Fill="#E86725"
                           Canvas.Left="230"
                           Canvas.Top="600"/>

                <Rectangle Width="40"
                           Height="100"
                           Fill="#C6441B"
                           Canvas.Left="940"
                           Canvas.Top="630"/>

                <Rectangle Width="25"
                           Height="50"
                           Fill="#E86725"
                           Canvas.Left="950"
                           Canvas.Top="600"/>

                <!-- 불씨 -->
                <Rectangle Width="12"
                           Height="12"
                           Fill="#F4A64B"
                           Canvas.Left="300"
                           Canvas.Top="200"/>

                <Rectangle Width="10"
                           Height="10"
                           Fill="#E86725"
                           Canvas.Left="900"
                           Canvas.Top="280"/>

            </Canvas>
        </Viewbox>

        <!-- 어두운 오버레이 -->
        <Rectangle Fill="#77000000"
                   IsHitTestVisible="False"/>

        <!-- 결과 화면 -->
        <Grid Margin="60,30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- GAME OVER -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center">

                <TextBlock Text="GAME OVER"
                           FontFamily="Consolas"
                           FontSize="62"
                           FontWeight="Black"
                           Foreground="#F28A3C"
                           HorizontalAlignment="Center">

                    <TextBlock.Effect>
                        <DropShadowEffect Color="#D93819"
                                          BlurRadius="12"
                                          ShadowDepth="5"
                                          Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text="THE FINAL JUDGEMENT"
                           FontFamily="Consolas"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#F2C27D"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,20"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Rectangle Width="100"
                               Height="5"
                               Fill="#A83B24"/>

                    <Rectangle Width="35"
                               Height="5"
                               Fill="#F2A34A"/>

                    <Rectangle Width="100"
                               Height="5"
                               Fill="#A83B24"/>
                </StackPanel>

            </StackPanel>

            <!-- 승리자 -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        Margin="0,25,0,25">

                <TextBlock x:Name="WinnerTitleText"
                           Text="★ THE SURVIVOR ★"
                           FontFamily="Consolas"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#F2C27D"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="WinnerNameText"
                           Text="PLAYER 1"
                           FontFamily="Consolas"
                           FontSize="48"
                           FontWeight="Black"
                           Foreground="#FFE1BF"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,5"/>

                <TextBlock x:Name="WinnerMessageText"
                           Text="FINAL WINNER"
                           FontFamily="Consolas"
                           FontSize="17"
                           Foreground="#E8A76B"
                           HorizontalAlignment="Center"/>

            </StackPanel>

            <!-- 최종 순위 -->
            <Border Grid.Row="2"
                    Width="650"
                    MaxHeight="290"
                    Background="#E6170E12"
                    BorderBrush="#A65335"
                    BorderThickness="3"
                    Padding="22"
                    HorizontalAlignment="Center">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="FINAL RANKING"
                               Style="{StaticResource PanelTitle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="RankingPanel"/>

                    </ScrollViewer>

                </Grid>
            </Border>

            <!-- 하단 버튼 -->
            <Grid Grid.Row="3"
                  Width="650"
                  HorizontalAlignment="Center"
                  Margin="0,25,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="다시 플레이"
                        Style="{StaticResource PixelButton}"
                        Click="ReplayButton_Click"/>

                <Button Grid.Column="2"
                        Content="메인 메뉴"
                        Style="{StaticResource PixelButton}"
                        Background="#21171A"
                        BorderBrush="#825449"
                        Click="MainMenuButton_Click"/>

            </Grid>

        </Grid>

        <!-- 버전 표시 -->
        <TextBlock Text="DEATH MARBLE  |  FINAL RESULT"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="#AA866D"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,20,12"/>

    </Grid>
</UserControl>