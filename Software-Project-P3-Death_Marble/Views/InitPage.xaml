                <Rectangle Width="80" Height="50"
                           Fill="#10090C"
                           Canvas.Left="480" Canvas.Top="270"/>

                <Rectangle Width="80" Height="50"
                           Fill="#10090C"
                           Canvas.Left="610" Canvas.Top="270"/>

                <Rectangle Width="80" Height="50"
                           Fill="#10090C"
                           Canvas.Left="740" Canvas.Top="270"/>

                <Rectangle Width="80" Height="50"
                           Fill="#10090C"
                           Canvas.Left="870" Canvas.Top="270"/>

                <!-- 기둥의 붉은 장식 -->
                <Rectangle Width="12" Height="410"
                           Fill="#7A2A1C"
                           Canvas.Left="338" Canvas.Top="390"/>

                <Rectangle Width="12" Height="410"
                           Fill="#7A2A1C"
                           Canvas.Left="850" Canvas.Top="390"/>

                <!-- 성벽 벽돌 무늬 -->
                <Rectangle Width="55" Height="8"
