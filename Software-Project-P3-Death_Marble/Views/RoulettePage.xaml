<UserControl x:Class="Software_Project_P3_Death_Marble.Views.RoulettePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#10080C"
             MinWidth="850"
             MinHeight="650">

    <UserControl.Resources>

        <Style x:Key="PixelButton" TargetType="Button">
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFF0D5"/>
            <Setter Property="Background" Value="#A52A20"/>
            <Setter Property="BorderBrush" Value="#F4A64B"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D94327"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,20">

            <TextBlock Text="TURN ROULETTE"
                       FontFamily="Consolas"
                       FontSize="46"
                       FontWeight="Black"
                       Foreground="#F28A3C"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="LET FATE DECIDE YOUR TURN"
                       FontFamily="Consolas"
                       FontSize="16"
                       Foreground="#F2C27D"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>

        </StackPanel>

        <!-- 중앙 콘텐츠 -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 룰렛 -->
            <Border Grid.Column="0"
                    Background="#1C1014"
                    BorderBrush="#A65335"
                    BorderThickness="3"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Viewbox Grid.Row="0"
                             Stretch="Uniform">

                        <Grid Width="460"
                              Height="460">

                            <!-- 룰렛 원판 -->
                            <Canvas x:Name="RouletteCanvas"
                                    Width="400"
                                    Height="400"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="RouletteRotation"
                                                     CenterX="200"
                                                     CenterY="200"/>
                                </Canvas.RenderTransform>

                            </Canvas>

                            <!-- 중앙 장식 -->
                            <Ellipse Width="65"
                                     Height="65"
                                     Fill="#210D12"
                                     Stroke="#F2C27D"
                                     StrokeThickness="5"/>

                            <TextBlock Text="DM"
                                       FontFamily="Consolas"
                                       FontSize="20"
                                       FontWeight="Black"
                                       Foreground="#F2C27D"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <!-- 고정 화살표 -->
                            <Polygon Points="0,0 35,0 17.5,35"
                                     Fill="#F2C27D"
                                     Stroke="#10080C"
                                     StrokeThickness="3"
                                     Width="35"
                                     Height="35"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="0,0,0,0"/>

                        </Grid>
                    </Viewbox>

                    <TextBlock Grid.Row="1"
                               x:Name="RouletteStatusText"
                               Text="룰렛을 돌려 턴 순서를 결정하세요."
                               FontFamily="Consolas"
                               FontSize="16"
                               Foreground="#FFE1BF"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,5"/>

                </Grid>
            </Border>

            <!-- 턴 순서 -->
            <Border Grid.Column="2"
                    Background="#170E12"
                    BorderBrush="#A65335"
                    BorderThickness="3"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="TURN ORDER"
                               FontFamily="Consolas"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#F2C27D"
                               Margin="0,0,0,20"/>

                    <StackPanel x:Name="TurnOrderPanel"/>

                    <Border Background="#29171A"
                            BorderBrush="#71372A"
                            BorderThickness="2"
                            Padding="12"
                            Margin="0,30,0,0">

                        <TextBlock Text="선택된 플레이어는 다음 추첨에서 제외됩니다."
                                   FontSize="14"
                                   Foreground="#E8C6A5"
                                   TextWrapping="Wrap"/>

                    </Border>

                </StackPanel>
            </Border>

        </Grid>

        <!-- 버튼 -->
        <StackPanel Grid.Row="2"
                    Width="500"
                    HorizontalAlignment="Center"
                    Margin="0,25,0,10">

            <Button x:Name="SpinButton"
                    Content="▶ 룰렛 돌리기"
                    Style="{StaticResource PixelButton}"
                    Click="SpinButton_Click"/>

            <Button x:Name="StartGameButton"
                    Content="▶ 게임 시작"
                    Style="{StaticResource PixelButton}"
                    Visibility="Collapsed"
                    Click="StartGameButton_Click"/>

        </StackPanel>

    </Grid>
</UserControl>