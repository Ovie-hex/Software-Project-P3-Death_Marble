                           Height="800"
                           Fill="#210A0D"/>

                <Rectangle Width="1200"
                           Height="250"
                           Canvas.Top="550"
                           Fill="#42100F"/>

                <Rectangle Width="1200"
                           Height="100"
                           Canvas.Top="700"
                           Fill="#64190F"/>

                <!-- 배경 픽셀 장식 -->
                <Rectangle Width="16" Height="16"
                           Fill="#7D2920"
                           Canvas.Left="100" Canvas.Top="100"/>

                <Rectangle Width="12" Height="12"
                           Fill="#B43C24"
                           Canvas.Left="180" Canvas.Top="180"/>

                <Rectangle Width="20" Height="20"
                           Fill="#6E201B"
                           Canvas.Left="980" Canvas.Top="130"/>

                <Rectangle Width="12" Height="12"
