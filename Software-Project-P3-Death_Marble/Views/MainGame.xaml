<UserControl x:Class="Software_Project_P3_Death_Marble.Views.MainGame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Software_Project_P3_Death_Marble.Views"
             Background="#10080C">

    <UserControl.Resources>
        <Style x:Key="GameButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFF0D5"/>
            <Setter Property="Background" Value="#A52A20"/>
            <Setter Property="BorderBrush" Value="#F4A64B"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <!-- 상단 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="DEATH MARBLE"
                       FontFamily="Consolas"
                       FontSize="36"
                       FontWeight="Black"
                       Foreground="#F28A3C"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="RoundText"
                           Text="ROUND 01 / 40"
                           FontFamily="Consolas"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#F2C27D"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="SuddenDeathText"
                           Text="NORMAL MODE"
                           FontFamily="Consolas"
                           FontSize="14"
                           Foreground="#E8C6A5"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 중앙 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- main의 실제 스테이지 보드와 확대·이동·경로 선택 UI -->
            <Border Grid.Column="0"
                    Background="#1B1014"
                    BorderBrush="#A65335"
                    BorderThickness="4"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="BoardNameText"
                               Text="INFERNAL BOARD"
                               FontFamily="Consolas"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#F2C27D"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,10"/>

                    <Canvas x:Name="BoardViewport"
                            Grid.Row="1"
                            Background="#201217"
                            ClipToBounds="True"
                            Cursor="Hand"
                            SizeChanged="BoardViewport_SizeChanged"
                            MouseLeftButtonDown="BoardViewport_MouseLeftButtonDown"
                            MouseMove="BoardViewport_MouseMove"
                            MouseLeftButtonUp="BoardViewport_MouseLeftButtonUp"
                            MouseWheel="BoardViewport_MouseWheel">
                        <Canvas x:Name="BoardCanvas"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0,0"/>
                    </Canvas>

                    <Border x:Name="PathChoiceOverlay"
                            Grid.Row="1"
                            Panel.ZIndex="10"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Padding="18"
                            Background="#F01B1014"
                            BorderBrush="#F4A64B"
                            BorderThickness="3">
                        <StackPanel>
                            <TextBlock Text="SELECT NEXT TILE"
                                       FontFamily="Consolas"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#F2C27D"
                                       Margin="0,0,0,10"/>
                            <WrapPanel x:Name="PathChoiceButtons"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CardTargetOverlay"
                            Grid.Row="1"
                            Panel.ZIndex="11"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="440"
                            Padding="18"
                            Background="#F01B1014"
                            BorderBrush="#F4A64B"
                            BorderThickness="3">
                        <StackPanel>
                            <TextBlock Text="대상 플레이어를 선택하세요"
                                       FontFamily="Consolas"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#F2C27D"/>
                            <TextBlock x:Name="CardTargetText"
                                       Foreground="#FFE1BF"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <WrapPanel x:Name="CardTargetButtons"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                            <Button x:Name="CancelTargetButton"
                                    Content="취소"
                                    Style="{StaticResource GameButton}"
                                    Height="38"
                                    Margin="0,12,0,0"
                                    Click="CancelTargetButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TeleportTargetOverlay"
                            Grid.Row="1"
                            Panel.ZIndex="12"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,12,0,0"
                            Padding="10,7"
                            Background="#E01B1014"
                            BorderBrush="#F4A64B"
                            BorderThickness="2">
                        <TextBlock x:Name="TeleportTargetText"
                                   Text="이동할 타일을 클릭하세요."
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#F2C27D"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 오른쪽 패널 -->
            <Border Grid.Column="2"
                    Background="#1B1014"
                    BorderBrush="#A65335"
                    BorderThickness="4"
                    Padding="8">
                <StackPanel>
                        <TextBlock Text="PLAYER STATUS"
                                   FontFamily="Consolas"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F2C27D"
                                   Margin="0,0,0,3"/>

                        <StackPanel x:Name="PlayerStatusPanel"/>

                        <Separator Background="#A65335"
                                   Margin="0,1"/>

                        <TextBlock Text="CURRENT TURN"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#F2C27D"/>

                        <TextBlock x:Name="CurrentTurnText"
                                   Text="PLAYER 1"
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   FontWeight="Black"
                                   Foreground="White"
                                   Margin="0,0,0,4"/>

                        <Border Background="#29171A"
                                BorderBrush="#A65335"
                                BorderThickness="3"
                                Padding="6">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <local:Dice3D x:Name="GameDice"
                                              Width="62"
                                              Height="62"
                                              Margin="0,0,10,0"/>

                                <TextBlock x:Name="DiceText"
                                           Text="READY"
                                           FontFamily="Consolas"
                                           FontSize="34"
                                           FontWeight="Black"
                                           Foreground="#F2C27D"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="RollControlHost"
                              Height="76"
                              Margin="0,3,0,0"
                              Cursor="Hand"
                              PreviewMouseLeftButtonDown="RollControlHost_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="RollControlHost_PreviewMouseLeftButtonUp"
                              PreviewMouseMove="RollControlHost_PreviewMouseMove">
                            <Button x:Name="RollDiceButton"
                                    Content="▶ 주사위 굴리기"
                                    Style="{StaticResource GameButton}"
                                    Height="46"
                                    VerticalAlignment="Center"
                                    Click="RollDiceButton_Click"/>
                            <Grid x:Name="DiceChoicePanel"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>

                        <Button Content="게임 종료"
                                Style="{StaticResource GameButton}"
                                Background="#25171B"
                                BorderBrush="#825449"
                                Height="34"
                                Margin="0,0,0,0"
                                Click="ExitButton_Click"/>
                    </StackPanel>
            </Border>
        </Grid>

        <!-- 플레이어별 카드와 게임 로그 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#170E12"
                    BorderBrush="#A65335"
                    BorderThickness="2"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="플레이어별 액티브 카드 · 주사위를 굴리기 전에 사용"
                               Foreground="#F2C27D"
                               FontSize="15"
                               FontWeight="Bold"/>

                    <ScrollViewer x:Name="HandScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Auto"
                                  SizeChanged="HandScrollViewer_SizeChanged">
                        <StackPanel x:Name="HandPanel"
                                    Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#170E12"
                    BorderBrush="#A65335"
                    BorderThickness="3"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="GAME LOG"
                               FontFamily="Consolas"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#F2C27D"/>

                    <ScrollViewer x:Name="LogScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,8,0,0">
                        <StackPanel x:Name="GameLogPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
